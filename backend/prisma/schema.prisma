generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pallet {
  id        Int             @id @default(autoincrement())
  numero    String          @unique
  rua       String?
  estrutura String?
  nivel     String?
  descricao String?         
  tipo      String?         
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  produtos  ProdutoPallet[] 
}

model ProdutoPallet {
  id         Int      @id @default(autoincrement())
  codigoItem String   @unique
  palletId   Int
  bipadoEm   DateTime @default(now())
  pallet     Pallet   @relation(fields: [palletId], references: [id], onDelete: Cascade)
}

model HistoricoMovimentacao {
  id             Int      @id @default(autoincrement())
  codigoItem     String   
  codigoAnterior String?  
  acao           String   
  palletOrigem   String?  
  palletDestino  String?  
  palletAlvo     String?
  usuarioId      Int?
  usuario        Usuario? @relation(fields: [usuarioId], references: [id])
  bipadoEm       DateTime @default(now())
  createdAt      DateTime @default(now())
}

model Usuario {
  id                Int                     @id @default(autoincrement())
  username          String                  @unique
  senha             String
  precisaMudarSenha Boolean                 @default(true)
  createdAt         DateTime                @default(now())
  historicos        HistoricoMovimentacao[]
  inbounds          InboundFull[]           
}

model Contador {
  id    Int    @id @default(autoincrement())
  chave String @unique
  valor Int    @default(0)
}

// ==========================================
// CADASTRO DE ATIVOS (FROTA)
// ==========================================

model Motorista {
  id        Int           @id @default(autoincrement())
  nome      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  inbounds  InboundFull[] // Histórico de cargas que este motorista trouxe
}

model Veiculo {
  id        Int           @id @default(autoincrement())
  modelo    String        // Ex: Iveco Daily
  placa     String        @unique // Placas não se repetem
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  inbounds  InboundFull[] // Histórico de cargas que este veículo trouxe
}

// ==========================================
// GESTOR DE ENVIOS FULL
// ==========================================

model InboundFull {
  id          Int          @id @default(autoincrement())
  numeroFrete String?      
  nomePallet  String       
  status      String       @default("PENDENTE") // PENDENTE, CONCLUIDO
  
  usuarioId   Int?
  usuario     Usuario?     @relation(fields: [usuarioId], references: [id])

  // Vínculos com a Frota adicionados aqui:
  motoristaId Int?
  motorista   Motorista?   @relation(fields: [motoristaId], references: [id])

  veiculoId   Int?
  veiculo     Veiculo?     @relation(fields: [veiculoId], references: [id])
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  
  skus        InboundSku[] 
}

model InboundSku {
  id               Int         @id @default(autoincrement())
  
  inboundId        Int
  inbound          InboundFull @relation(fields: [inboundId], references: [id], onDelete: Cascade)
  
  sku              String      
  descricao        String      
  quantidadeTotal  Int         
  quantidadeBipada Int         @default(0) 
  
  status           String      @default("PENDENTE") 
  variacoes        Json?       
  
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}