generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ACESSOS E SEGURANÇA
// ==========================================

model Cargo {
  id         Int       @id @default(autoincrement())
  nome       String    @unique
  permissoes String[]  @default([]) // Array de strings nativo do PostgreSQL
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  usuarios   Usuario[]
}

model Usuario {
  id                 Int                     @id @default(autoincrement())
  username           String                  @unique
  senha              String
  precisaMudarSenha  Boolean                 @default(true)
  
  cargoId            Int?
  cargo              Cargo?                  @relation(fields: [cargoId], references: [id])
  
  createdAt          DateTime                @default(now())
  historicos         HistoricoMovimentacao[]
  inbounds           InboundFull[]           
}

// ==========================================
// MALHA OPERACIONAL E ESTOQUE
// ==========================================

model Pallet {
  id        Int             @id @default(autoincrement())
  numero    String          @unique
  rua       String?
  estrutura String?
  nivel     String?
  descricao String?         
  tipo      String?         
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  produtos  ProdutoPallet[] 
}

model ProdutoPallet {
  id         Int      @id @default(autoincrement())
  codigoItem String   @unique
  palletId   Int
  bipadoEm   DateTime @default(now())
  pallet     Pallet   @relation(fields: [palletId], references: [id], onDelete: Cascade)
}

model HistoricoMovimentacao {
  id             Int      @id @default(autoincrement())
  codigoItem     String   
  codigoAnterior String?  
  acao           String   
  palletOrigem   String?  
  palletDestino  String?  
  palletAlvo     String?
  usuarioId      Int?
  usuario        Usuario? @relation(fields: [usuarioId], references: [id])
  bipadoEm       DateTime @default(now())
  createdAt      DateTime @default(now())
}

model Contador {
  id    Int    @id @default(autoincrement())
  chave String @unique
  valor Int    @default(0)
}

// ==========================================
// GESTOR DE ENVIOS FULL (MERCADO LIVRE)
// ==========================================

model InboundFull {
  id          Int          @id @default(autoincrement())
  numeroFrete String?      // Ex: 72595700 (Caso queira extrair e buscar depois)
  nomePallet  String       // Nome lógico dado pelo operador no app (Ex: Pallet Eletrônicos Sul)
  status      String       @default("PENDENTE") // Pode ser: PENDENTE, BIPANDO, CONCLUIDO
  
  usuarioId   Int?
  usuario     Usuario?     @relation(fields: [usuarioId], references: [id])
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  
  skus        InboundSku[] // Relacionamento com os SKUs deste envio
}

model InboundSku {
  id               Int         @id @default(autoincrement())
  
  inboundId        Int
  inbound          InboundFull @relation(fields: [inboundId], references: [id], onDelete: Cascade)
  
  sku              String      // Código do SKU extraído do PDF
  descricao        String      // Descrição do produto
  quantidadeTotal  Int         // Total solicitado pelo Mercado Livre
  quantidadeBipada Int         @default(0) // Contador de quantos já foram bipados
  
  status           String      @default("PENDENTE") // PENDENTE ou CONCLUIDO
  variacoes        Json?       // Guarda os códigos ML/EAN
  
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}